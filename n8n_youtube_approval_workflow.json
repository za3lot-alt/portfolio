{
  "name": "YouTube 3-Stage Approval Pipeline",
  "nodes": [
    {
      "id": "f8d08505-bbbe-475f-86de-547a846a2ae5",
      "name": "Notion Trigger",
      "type": "n8n-nodes-base.notionTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "event": "pageUpdated",
        "databaseId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "simple": false,
        "conditions": {
          "string": [
            {
              "key": "properties.Status.select.name",
              "operation": "equals",
              "value": "Submitted"
            }
          ]
        }
      },
      "onError": "stopWorkflow"
    },
    {
      "id": "56c9fbf1-4b5b-4129-960b-2c3107646aaa",
      "name": "Telegram Node 2",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        200,
        0
      ],
      "parameters": {
        "chatId": "={{$env.NODE_2_CHAT_ID || '123456789'}}",
        "text": "={{ 'New Video Submission:\\nTitle: ' + $json.properties.Title.title[0].plain_text + '\\nDescription: ' + $json.properties.Description.rich_text[0].plain_text + '\\nTags: ' + $json.properties.Tags.rich_text[0].plain_text + '\\nAd Copy: ' + $json.properties.Ad_Copy.rich_text[0].plain_text + '\\n\\nDrive Link: ' + $json.properties.Video_Drive_Link.url }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "\u2705 Approve",
                    "url": "={{$execution.resumeUrl}}?action=approve"
                  },
                  {
                    "text": "\u274c Reject",
                    "url": "={{$execution.resumeUrl}}?action=reject"
                  }
                ]
              }
            }
          ]
        }
      },
      "onError": "stopWorkflow"
    },
    {
      "id": "183fb5ac-ae0c-4447-943c-cb5993ac3130",
